# ---- LLM provider (OpenAI-compatible chat-completions API) ----
# Leave all three empty to run in FREE retrieval-only mode:
# answers are extractive snippets from cited chunks, no key needed.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Retrieval ----
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5

# ---- Paths ----
DATA_DIR=data
HF_HOME=
